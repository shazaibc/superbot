[Unit]
Description=SuperBot server (botd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=superbot
Group=superbot
WorkingDirectory=/home/superbot/superbot
EnvironmentFile=/home/superbot/superbot/.env
ExecStart=/home/superbot/superbot/target/release/botd
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
